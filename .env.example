# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Auth & PostgreSQL Integration
# Optional: If not provided, BikriPilot runs in self-contained sandbox mode
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Server-Only Privileged Credentials (NEVER exposed to frontend bundle)
SUPABASE_SERVICE_ROLE_KEY="your-server-service-role-key"
ADMIN_SECRET_KEY="bikripilot_admin_secret_2026"
SESSION_SECRET="bikripilot_secure_session_secret_2026_x7a9"

# Defense-in-depth: Optional custom admin route prefix (default: 'admin')
ADMIN_ROUTE_PREFIX="admin"
