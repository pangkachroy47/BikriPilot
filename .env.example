# ============================================================
# BikriPilot Environment Variables
# ============================================================

# AI & Runtime Variables (Injected by AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Supabase Client Configuration (Exposed to Vite frontend bundle via VITE_ prefix)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Server-Side Privileged Credentials (STRICTLY SERVER-ONLY - NEVER prefix with VITE_)
# Used for backend administrative operations and database RLS bypass
SUPABASE_SECRET_KEY="your-server-secret-key"

# Server Admin Panel Security & Session Management (STRICTLY SERVER-ONLY)
ADMIN_SECRET_KEY="bikripilot_admin_secret_2026"
SESSION_SECRET="bikripilot_secure_session_secret_2026_x7a9"

# Defense-in-depth: Optional custom admin route prefix (default: 'admin')
ADMIN_ROUTE_PREFIX="admin"

# ------------------------------------------------------------
# Backward Compatibility Fallbacks (Supported internally for migrations):
# VITE_SUPABASE_ANON_KEY (fallback for VITE_SUPABASE_PUBLISHABLE_KEY)
# SUPABASE_SERVICE_ROLE_KEY (fallback for SUPABASE_SECRET_KEY)
# ------------------------------------------------------------

